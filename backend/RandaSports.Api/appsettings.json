{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "Gemini": {
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 300
  },

  "AuthPolicy": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 8
  },

  "Jwt": {
    "Issuer": "RandaSports",
    "Audience": "RandaSports.Admin",
    "LifetimeMinutes": 60,
    "RefreshLifetimeDays": 30
  }
}
