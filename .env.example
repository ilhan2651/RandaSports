# .env olarak kopyala ve doldur. Bu dosya .gitignore'da; depoya girmiyor.
#
#   Yerelde:   copy .env.example .env        (PowerShell/Linux: cp)
#   Sunucuda:  cp .env.example .env && chmod 600 .env
#
# Aşağıda YEREL ve SUNUCU diye iki blok var; hangisindeysen onu aç, diğerini
# yorumda bırak. Sonra iki yerde de aynı komut:  docker compose up -d --build

# ===========================================================================
# YEREL GELİŞTİRME
# ===========================================================================
# COMPOSE_FILE'daki dosyaları ayıran karakter. Windows'ta varsayılan ";",
# Linux'ta ":" — bu satır olmadan aynı .env iki yerde birden çalışmıyor.
COMPOSE_PATH_SEPARATOR=:

# Projenin kendi Postgres konteynerini de kaldırır.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

POSTGRES_USER=randasports
POSTGRES_PASSWORD=randasports_dev
POSTGRES_DB=randasports

SITE_URL=http://localhost:3000

# ===========================================================================
# SUNUCU — yukarıdaki üç satırı ve COMPOSE_FILE'ı yorumla, bunları aç
# ===========================================================================
# Paylaşılan Caddy ve Postgres'e bağlanır, kendi veritabanını açmaz.
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Ortak infra Postgres konteynerinin adı. `docker ps` ile doğrula; infra
# projesinin adı değişirse bu da değişir.
#DB_HOST=infra-postgres-1

# Paylaşılan Postgres'te RandaSports'a açılan ayrı veritabanı ve kullanıcı.
# Parolayı üret:  openssl rand -base64 24
#POSTGRES_USER=randasports
#POSTGRES_PASSWORD=
#POSTGRES_DB=randasports

#SITE_URL=https://randasports.randaprojects.tr

# ===========================================================================
# HER İKİ ORTAMDA DA GEREKLİ
# ===========================================================================

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://www.api-football.com/
APISPORTS_API_KEY=

# Jeton imza anahtarı. En az 32 karakter:  openssl rand -base64 48
# Sunucuda yereldekinden FARKLI olmalı.
JWT_KEY=

# İlk yönetici. Yalnızca hesap yoksa oluşturuluyor.
# GİRİŞ YAPTIKTAN SONRA BU ÜÇÜNÜ BOŞALTIP `docker compose up -d` DE.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=
