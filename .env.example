# .env olarak kopyala ve doldur. Bu dosya .gitignore'da; depoya girmiyor.
#
#   Yerelde:   copy .env.example .env     (PowerShell/Linux: cp)
#   Sunucuda:  cp .env.example .env && chmod 600 .env
#
# Değiştirdikten sonra:  docker compose up -d

# --- Veritabanı -------------------------------------------------------------
# Yerelde olduğu gibi bırakabilirsin. SUNUCUDA PAROLAYI MUTLAKA DEĞİŞTİR:
#   openssl rand -base64 24
POSTGRES_USER=randasports
POSTGRES_PASSWORD=randasports_dev
POSTGRES_DB=randasports

# --- Anahtarlar -------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://www.api-football.com/
APISPORTS_API_KEY=

# Jeton imza anahtarı. En az 32 karakter, rastgele:  openssl rand -base64 48
# Sunucuda yereldekinden FARKLI olmalı.
JWT_KEY=

# --- Site -------------------------------------------------------------------
# Sitenin dışarıdan görünen adresi. Site haritası, mutlak bağlantılar ve API'nin
# CORS listesi bunu kullanıyor. Sunucuda: https://randasports.randaprojects.tr
SITE_URL=http://localhost:3000

# --- İlk yönetici -----------------------------------------------------------
# Yalnızca ilk açılışta hesap yoksa oluşturuluyor.
# GİRİŞ YAPTIKTAN SONRA BU ÜÇ SATIRI SİLİP `docker compose up -d` DE.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULLNAME=

# ---------------------------------------------------------------------------
# YALNIZCA SUNUCUDA: aşağıdaki üç satırın başındaki # işaretini kaldır.
# Yerelde açık bırakırsan Caddy ayağa kalkmaya ve gerçek alan adı için
# sertifika almaya çalışır, başarısız olur.
# ---------------------------------------------------------------------------

# Bu satır sayesinde sunucuda düz `docker compose up -d` komutu Caddy'yi de
# kapsıyor; her seferinde -f yazmaya gerek kalmıyor.
#COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Caddy'nin sertifika alacağı alan adı (şema olmadan).
#SITE_DOMAIN=randasports.randaprojects.tr

# Let's Encrypt bildirimleri bu adrese gidiyor (sertifika bitmek üzereyken).
#ACME_EMAIL=
