# Caddy, sertifikayı Let's Encrypt'ten kendisi alıyor ve süresi dolmadan kendisi
# yeniliyor. Bunun için 80 ve 443 portlarının dışarıya açık ve alan adının bu
# sunucuya bakıyor olması yeterli; başka bir adım yok.

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Yalnızca site yayınlanıyor. API dışarı açılmıyor: bütün sayfalar sunucu
	# tarafında üretildiği için API'ye Docker ağı üzerinden gidiliyor, tarayıcı
	# onu hiç görmüyor. Açmaya gerek yoksa açmıyoruz.
	reverse_proxy web:3000

	header {
		# Tarayıcı bu alan adına bir daha düz HTTP ile gelmesin.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}
